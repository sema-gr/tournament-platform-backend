generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  PLAYER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String            @id @default(uuid())
  email               String            @unique
  username            String            @unique
  password            String
  name                String
  role                Role              @default(PLAYER)
  organizationName    String?
  isApprovedOrganizer Boolean           @default(false)
  organizerStatus     ApplicationStatus @default(PENDING)

  teams      TeamMember[]
  ownedTeams Team[]       @relation("TeamOwner")

  tournaments Tournament[] @relation("OrganizerTournaments")
  stats       PlayerStats?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  teamJoinRequests TeamJoinRequest[]

  notifications Notification[]

  teamInvitations TeamInvitation[]
}

model TeamJoinRequest {
  id        String            @id @default(uuid())
  userId    String
  teamId    String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model TeamInvitation {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamMember {
  id     String @id @default(uuid())
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model PlayerStats {
  id          String @id @default(uuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id])
  gamesPlayed Int    @default(0)
  wins        Int    @default(0)
  losses      Int    @default(0)
}

model Category {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  minPlayers  Int          @default(1)
  maxPlayers  Int          @default(1)
  tournaments Tournament[]
}

enum TournamentStatus {
  PLANNED
  REGISTRATION
  ACTIVE
  FINISHED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  ROUND_ROBIN
}

model Tournament {
  id          String           @id @default(uuid())
  title       String
  description String?
  format      TournamentFormat @default(SINGLE_ELIMINATION)
  status      TournamentStatus @default(PLANNED)
  maxTeams    Int
  startDate   DateTime

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  organizerId String
  organizer   User   @relation("OrganizerTournaments", fields: [organizerId], references: [id])

  registrations Registration[]
  matches       Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id   String @id @default(uuid())
  name String @unique

  isPrivate Boolean @default(false)

  ownerId String
  owner   User   @relation("TeamOwner", fields: [ownerId], references: [id])

  members TeamMember[]

  registrations Registration[]
  matchesA      Match[]        @relation("MatchTeamA")
  matchesB      Match[]        @relation("MatchTeamB")
  wonMatches    Match[]        @relation("MatchWinner")

  createdAt        DateTime          @default(now())
  teamJoinRequests TeamJoinRequest[]

  teamInvitations TeamInvitation[]
}

model Registration {
  id           String            @id @default(uuid())
  status       ApplicationStatus @default(PENDING)
  tournamentId String
  teamId       String

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tournamentId, teamId])
}

model Match {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  teamAId String?
  teamBId String?
  teamA   Team?   @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamB   Team?   @relation("MatchTeamB", fields: [teamBId], references: [id])

  scoreA   Int     @default(0)
  scoreB   Int     @default(0)
  winnerId String?
  winner   Team?   @relation("MatchWinner", fields: [winnerId], references: [id])

  nextMatchId     String?
  nextMatch       Match?  @relation("NextMatch", fields: [nextMatchId], references: [id])
  previousMatches Match[] @relation("NextMatch")

  status MatchStatus @default(SCHEDULED)
  round  Int?
  date   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MatchStatus {
  SCHEDULED
  ONGOING
  FINISHED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  TEAM_JOIN_REQUEST
  TOURNAMENT_UPDATE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
